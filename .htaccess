# =========================================================
# HelloSuggest: clean URLs, SEO feeds, security basics
# =========================================================

Options -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
	RewriteEngine On

	# --- 0) 301 legacy blog-single.php?slug=... / blog-single?slug=... to the clean slug URL ---
	RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)?blog-single(?:\.php)?\?slug=([^&\s]+) [NC]
	RewriteRule ^ /%1%2 [R=301,L,QSD]

	# --- 1) 301 old *.php URLs to clean, extensionless URLs ---
	RewriteCond %{THE_REQUEST} \s/+([^?\s]+/)index\.php[?\s] [NC]
	RewriteRule ^ /%1 [R=301,L]

	RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[?\s] [NC]
	RewriteRule ^ /%1 [R=301,L]

	# --- 2) Route SEO feed clean URLs to their generators ---
	RewriteRule ^robots\.txt$ robots.php [L]
	RewriteRule ^llms\.txt$ llms.php [L]
	RewriteRule ^sitemap\.xml$ sitemap.php [L]

	# --- 3) Serve existing files and directories as-is ---
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# --- 4) Map any other clean URL to its .php file ---
	RewriteCond %{REQUEST_FILENAME}.php -f
	RewriteRule ^(.+?)/?$ $1.php [L]

	# --- 4a) development/ content pages served from a one-segment clean URL ---
	RewriteCond %{REQUEST_FILENAME}.php !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} ^(.*/)([a-zA-Z0-9\-]+)$
	RewriteCond %1development/%2.php -f
	RewriteRule ^([a-zA-Z0-9\-]+)/?$ development/$1.php [L]

	# --- 5) Service pages: try serving Pages/<slug>.php first ---
	RewriteRule ^([a-zA-Z0-9\-]+)/?$ Pages/$1.php [L]

	# --- 4b) If no Pages file exists, the slug is a blog post ---
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^Pages/([a-zA-Z0-9\-]+)\.php$ blog-single.php?slug=$1 [L]

	# --- 6) Fallback: any remaining unknown path serves the 404 page ---
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^.*$ 404.php [L]
</IfModule>

# --- Prevent direct access to runtime data files ---
<FilesMatch "\.(jsonl|log)$">
	Require all denied
</FilesMatch>

# --- Basic protection: block .git exposure ---
<IfModule mod_rewrite.c>
	RewriteRule ^\.git/ - [F,L]
</IfModule>
